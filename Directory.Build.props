<Project>
  <PropertyGroup>
    <!-- Release versions are UTC dates (yyyy.M.d[.n]) passed with -p:Version=...; local builds are 0.0.0-dev. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>Khalid Abuhakmeh</Authors>
    <Copyright>Copyright (c) 2026 Khalid Abuhakmeh</Copyright>
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
