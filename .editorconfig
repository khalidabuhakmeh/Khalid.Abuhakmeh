root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{verified.txt,received.txt}]
insert_final_newline = false
trim_trailing_whitespace = false
charset = utf-8
